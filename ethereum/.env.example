# =============================================================================
# Shared
# =============================================================================

# RPC endpoint of the chain you are deploying to.
#   - For `DeployUtexoSourceEntrypoint`: the source chain (Ethereum, OP, Base, …)
#   - For `DeployUtexoLZAdapter`:        the destination chain (Arbitrum)
RPC_URL=

# Deployer private key (same value works for both scripts; the deployer EOA
# only needs gas on whichever chain is being deployed to).
PRIVATE_KEY=

# =============================================================================
# DeployUtexoSourceEntrypoint (source chain — Ethereum / OP / Base / …)
# =============================================================================

# ERC-20 token pulled from users on this source chain.
# On Ethereum: canonical USDT address.
# On chains where USDT0 is the native token: USDT0 token address (often same
# as OFT_ADDRESS).
TOKEN_ADDRESS=

# USDT0 OFT (adapter or native OFT) deployed on this source chain.
OFT_ADDRESS=

# LayerZero V2 endpoint id of the destination chain.
# Arbitrum One = 30110.
DST_EID=30110

# UtexoLZAdapter contract address on the destination chain, encoded as bytes32.
# Left-pad the 20-byte address with zeros:
#   e.g. 0x000000000000000000000000<UtexoLZAdapter_address_without_0x>
LZ_ADAPTER=

# Initial owner of UtexoSourceEntrypoint. This can differ from the deployer;
# use the operational multisig address for production deployments.
OWNER_ADDRESS=

# =============================================================================
# DeployUtexoLZAdapter (destination chain — Arbitrum)
#
# Reuses `TOKEN_ADDRESS` and `OFT_ADDRESS` from above, but pointed at the
# destination-chain instances (USDT0 token + OFT on Arbitrum). Set them to the
# Arbitrum values when running this script.
# =============================================================================

# LayerZero V2 EndpointV2 contract on the destination chain.
LZ_ENDPOINT_ADDRESS=

# Utexo `Bridge` contract on the destination chain. Until federation rotates
# `lzAdapter` on the Bridge to this deployment, the adapter-only
# `Bridge.fundsIn` overload reverts `NotLZAdapter`.
BRIDGE_ADDRESS=

# Utexo `MultisigProxy` contract on the destination chain. Gates `sendOut`,
# `refundStuckFunds` and `setTrustedEntrypoint` on the adapter.
MULTISIG_PROXY_ADDRESS=
