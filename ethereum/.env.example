# Deployment inputs. Run from ethereum/ and load with:
#   set -a; source .env; set +a
# RPC_URL is used by forge --rpc-url, not read by the scripts.
# Use the source-chain RPC for the entrypoint and the Arbitrum RPC for the adapter.
RPC_URL=
PRIVATE_KEY=

# DeployUtexoSourceEntrypoint
# Source token; the configured OFT's token() must return this address.
TOKEN_ADDRESS=
# Source OFT; it can be separate from the token or the token contract itself.
OFT_ADDRESS=
# Destination LayerZero EID, distinct from the Bridge destination chain id.
# Arbitrum One: EID 30110, chain id 42161.
DST_EID=30110
# Nonzero Arbitrum adapter address encoded as 0x + 24 zero hex digits + 40 address digits.
LZ_ADAPTER=
# Initial entrypoint owner; may differ from the deployer.
OWNER_ADDRESS=

# DeployUtexoLZAdapter (Arbitrum)
# Set TOKEN_ADDRESS above to the Arbitrum USDT0 token for this deployment.
LZ_ENDPOINT_ADDRESS=
# Nonempty comma-separated lists of equal length, matched by position.
# Entries are remote EIDs and local Arbitrum OFTs. Each OFT must report TOKEN_ADDRESS
# and have a nonzero peer for its EID.
OFT_EIDS=
OFT_ADDRESSES=
# Hub Bridge proxy; configure its trusted adapter before accepting deposits.
BRIDGE_ADDRESS=
# Governance MultisigProxy, distinct from the Bridge proxy.
MULTISIG_PROXY_ADDRESS=
