# Deployer keys for the selected Tron network.
PRIVATE_KEY_MAINNET=
PRIVATE_KEY_SHASTA=
PRIVATE_KEY_NILE=
# Optional development key; empty uses the TRE fixture key from tronbox-config.js.
PRIVATE_KEY_DEVELOPMENT=
# Local node host port; map the container's node port to this value.
HOST_PORT=9095

# Migration inputs. Load into the shell before using the README command:
#   set -a; source .env; set +a
# Source-network Tron token, OFT and initial owner addresses.
# OFT_ADDRESS must report TOKEN_ADDRESS through token().
TOKEN_ADDRESS=
OFT_ADDRESS=
OWNER_ADDRESS=
# Destination LayerZero EID (Arbitrum One).
DST_EID=30110
# Nonzero Arbitrum adapter address, left-padded with twelve zero bytes.
LZ_ADAPTER=
